    ETL_Clms_Inst_Analytics:
      name: ETL_Clms_Inst_Analytics
      email_notifications:
        on_failure:
          - jaime.zavala@gainwelltechnologies.com
        no_alert_for_skipped_runs: true
      tasks:
        - task_key: ETL_Clms_Inst_Analytics
          notebook_task:
            notebook_path: EDW_ETL/Refactor/ETL_Claims/ETL_Clms_Inst_Analytics
            base_parameters:
              CleanDstntTblsFlag: F
              VEN12501FA: EDW_VEN12501FA_Staging
            source: GIT
          new_cluster:
            cluster_name: ""
            spark_version: 16.1.x-scala2.12
            spark_conf:
              spark.databricks.driver.ipykernel.commChannelEnabled: "False"
            aws_attributes:
              first_on_demand: 1
              availability: SPOT_WITH_FALLBACK
              zone_id: auto
              instance_profile_arn: arn:aws:iam::721214004216:instance-profile/gia-stg-oh-ue1-data-ec2role
              spot_bid_price_percent: 100
              ebs_volume_count: 0
            node_type_id: i4i.8xlarge
            custom_tags:
              Company: gainwell technologies
              Env: stg
              Aws_Account_Number: "721214004216"
              Email: support-gia-de@mygainwell.onmicrosoft.com
              Tenant: oh_haven
              Team: gia-de
              Project: gia
              Infra_Service: fbae79be939839d0ca737f4badba10d8
              Product: analytics
              App_Service: 3401e33d9367e5508cf7324e1dba1059
              Aws_Region: us-east-1
            enable_elastic_disk: true
            policy_id: 0019F7C702C5E025
            data_security_mode: SINGLE_USER
            runtime_engine: PHOTON
            autoscale:
              min_workers: 2
              max_workers: 20
      git_source:
        git_url: https://github.com/mygainwell/act-oh-apm-databricks
        git_provider: gitHub
        git_branch: stage
      parameters:
        - name: catalog
          default: oh_apm_stg
        - name: cl_inst
          default: EDW_temp_cl_inst
        - name: cl_inst_stg
          default: EDW_temp_cl_inst_staging
        - name: hipaa_820_raw
          default: hipaa_820_raw
        - name: Inst_Analytics
          default: EDW_temp_Inst_Analytics
        - name: Inst_Analytics_stg
          default: EDW_temp_Inst_Analytics_staging
        - name: schema_name
          default: archive_vendor_extracts
        - name: schema_name_mc
